              "raw": "{\n  \"title\": \"Transfer window discussion\",\n  \"content\": \"What transfers should our team make?\",\n  \"type\": \"TEAM\",\n  \"teamId\": 1,\n  \"tags\": [\"transfers\", \"discussion\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/threads",
              "host": ["{{baseUrl}}"],
              "path": ["api", "threads"]
            },
            "description": "Create a team-specific discussion thread. Requires teamId."
          }
        },
        {
          "name": "Get Thread by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/threads/{{threadId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "threads", "{{threadId}}"]
            },
            "description": "Get a specific thread with posts, polls, and tags."
          }
        },
        {
          "name": "Update Thread",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\",\n  \"content\": \"Updated content for this thread\",\n  \"tags\": [\"updated\", \"discussion\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/threads/{{threadId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "threads", "{{threadId}}"]
            },
            "description": "Update a thread's title, content, or tags. Only the author can edit."
          }
        },
        {
          "name": "Delete Thread",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/threads/{{threadId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "threads", "{{threadId}}"]
            },
            "description": "Delete a thread. Only the author or admin can delete."
          }
        },
        {
          "name": "Search Threads",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/threads/search?q=premier&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "threads", "search"],
              "query": [
                { "key": "q", "value": "premier" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "title", "value": "", "disabled": true },
                { "key": "author", "value": "", "disabled": true },
                { "key": "team", "value": "", "disabled": true },
                { "key": "tag", "value": "", "disabled": true }
              ]
            },
            "description": "Search threads by query text, title, author username, team name, or tag."
          }
        }
      ]
    },
