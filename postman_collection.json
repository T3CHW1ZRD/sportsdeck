            },
            "url": {
              "raw": "{{baseUrl}}/api/threads",
              "host": ["{{baseUrl}}"],
              "path": ["api", "threads"]
            },
            "description": "Create a new general discussion thread with tags. Requires authentication."
          }
        },
        {
          "name": "Create Thread (Team)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.thread) {",
                  "    pm.collectionVariables.set('threadId', jsonData.thread.id);",
                  "}"
