    {
      "name": "Polls",
      "description": "Create and vote on polls within discussion threads.",
      "item": [
        {
          "name": "Create Poll in Thread",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.poll) {",
                  "    pm.collectionVariables.set('pollId', jsonData.poll.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
