{
  "info": {
    "name": "SportsDeck API - Premier League",
    "description": "Complete API collection for SportsDeck - a Premier League discussion platform. Includes authentication, matches, threads, posts, polls, moderation, social features, and AI-powered enhancements.\n\nSetup:\n1. Run startup.sh to initialize the database\n2. Run run.sh to start the server\n3. Use the Signup or Login endpoints first - tokens are automatically saved\n4. All authenticated endpoints use the saved token automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "threadId",
      "value": "",
      "type": "string"
    },
    {
      "key": "postId",
      "value": "",
      "type": "string"
    },
    {
      "key": "pollId",
      "value": "",
      "type": "string"
    },
    {
      "key": "teamId",
      "value": "",
      "type": "string"
    },
    {
      "key": "matchId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reportId",
      "value": "",
      "type": "string"
    },
    {
      "key": "appealId",
      "value": "",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints: signup, login, refresh token, and profile management.",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "    pm.collectionVariables.set('userId', jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\",\n  \"username\": \"testuser\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signup"]
            },
            "description": "Register a new user. Returns JWT tokens which are automatically saved."
          }
        },
        {
          "name": "Signup Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('adminAccessToken', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sportsdeck.com\",\n  \"password\": \"<YOUR_ADMIN_PASSWORD>\",\n  \"username\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signup"]
            },
            "description": "Register an admin user. Note: After signup, manually set role to ADMIN in DB, or use the seeded admin account."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "    pm.collectionVariables.set('userId', jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Log in with email and password. Returns JWT tokens which are automatically saved."
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('adminAccessToken', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sportsdeck.com\",\n  \"password\": \"<YOUR_ADMIN_PASSWORD>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Log in as admin. Token is saved to adminAccessToken variable."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Refresh the access token using a refresh token."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Logout and invalidate token so it can no longer be used."
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Get the authenticated user's profile including favorite team and follower counts."
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newusername\",\n  \"avatar\": \"https://example.com/avatar.jpg\",\n  \"favoriteTeamId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Update profile fields: username, avatar, favoriteTeamId, or password (requires currentPassword)."
          }
        }
      ]
    },
    {
      "name": "Teams",
      "description": "Browse league teams stored in the database.",
      "item": [
        {
          "name": "List Teams",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set('teamId', jsonData.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/teams?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teams"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "List all Premier League teams with pagination."
          }
        },
        {
          "name": "Get Team by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/teams/{{teamId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teams", "{{teamId}}"]
            },
            "description": "Get a specific team with recent matches."
          }
        }
      ]
    },
    {
      "name": "Matches",
      "description": "View and manage match data from the Premier League.",
      "item": [
        {
          "name": "Sync Matches from API",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/matches/sync",
              "host": ["{{baseUrl}}"],
              "path": ["api", "matches", "sync"]
            },
            "description": "Sync matches from football-data.org to the local database. Updates scores and adds new matches."
          }
        },
        {
          "name": "List Matches",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set('matchId', jsonData.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/matches?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "matches"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "matchday", "value": "1", "disabled": true },
                { "key": "status", "value": "FINISHED", "disabled": true },
                { "key": "teamId", "value": "1", "disabled": true },
                { "key": "dateFrom", "value": "2025-08-01", "disabled": true },
                { "key": "dateTo", "value": "2026-05-30", "disabled": true },
                { "key": "stage", "value": "REGULAR_SEASON", "disabled": true }
              ]
            },
            "description": "List matches with optional filters: matchday, status, teamId, dateFrom, dateTo."
          }
        },
        {
          "name": "Get Match by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/matches/{{matchId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "matches", "{{matchId}}"]
            },
            "description": "Get a specific match with team details and associated threads."
          }
        },
        {
          "name": "Get Matches by Matchday",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/matches/matchday/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "matches", "matchday", "1"]
            },
            "description": "Get all matches for a specific matchday."
          }
        },
        {
          "name": "Get Standings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/standings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "standings"]
            },
            "description": "Get current Premier League standings from football-data.org (cached)."
          }
        }
      ]
    },
