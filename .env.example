DATABASE_URL="file:./dev.db"

# football-data.org API key (free tier)
FOOTBALL_DATA_API_KEY="YOUR_FOOTBALL_DATA_API_KEY"

# JWT secret for authentication
JWT_SECRET="sportsdeck-super-secret-jwt-key-change-me"
JWT_REFRESH_SECRET="sportsdeck-refresh-secret-key-change-me"

# Hugging Face API token (free tier)
HUGGINGFACE_API_TOKEN="YOUR_HUGGINGFACE_API_TOKEN"

# Competition code for Premier League
COMPETITION_CODE="PL"

# Admin user seeded by scripts/seed.ts (required; change before any non-local deployment)
ADMIN_EMAIL="admin@sportsdeck.com"
ADMIN_PASSWORD="adminpass123"
ADMIN_USERNAME="admin"

# Server port
PORT=3000